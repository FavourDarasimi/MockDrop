# Redis Cloud (free tier, 30MB, standard TCP).
# Local development:
#   REDIS_URL=redis://localhost:6379
# Redis Cloud (note: rediss:// for TLS-enabled endpoints):
#   REDIS_URL=redis://<user>:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# Optional. Origin used to build the returned mock URL.
# Leave unset and the API derives it from the incoming request headers, which
# is correct on both localhost and Vercel. Set it only if you serve MockDrop
# behind a proxy that rewrites Host.
# MOCKDROP_BASE_URL=https://mockdrop.app
